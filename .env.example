# Canonical origin, no trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com
# "true" ONLY on production. Anything else => noindex + robots Disallow
NEXT_PUBLIC_ALLOW_INDEXING=false
# CMS/API base. Empty => uses seed content in src/lib/content.ts
CMS_API_URL=
CMS_API_TOKEN=
# Shared secret for POST /api/revalidate (openssl rand -hex 32)
REVALIDATE_SECRET=
